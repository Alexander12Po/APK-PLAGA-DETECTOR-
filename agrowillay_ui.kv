#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior

RootLayout:

# ---------------------------------------------------------------------------
# Componentes 3D y Efectos de Relieve Visual
# ---------------------------------------------------------------------------

<SectionCard3D@MDBoxLayout>:
    orientation: "vertical"
    padding: dp(18)
    spacing: dp(14)
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.55
        RoundedRectangle:
            pos: self.x, self.y - dp(5)
            size: self.size
            radius: [22,]
        Color:
            rgba: 0.18, 0.85, 0.55, 0.3
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(1)
            size: self.width + dp(2), self.height + dp(2)
            radius: [23,]
        Color:
            rgba: 0.07, 0.09, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [22,]

<StepBadge3D@FloatLayout>:
    icon: "camera-iris"
    size_hint: None, None
    size: dp(46), dp(46)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.4
        Ellipse:
            pos: self.x, self.y - dp(3)
            size: self.size
        Color:
            rgba: 0.20, 0.95, 0.60, 1
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.08, 0.55, 0.35, 1
        Ellipse:
            pos: self.x + dp(3), self.y + dp(3)
            size: self.width - dp(6), self.height - dp(6)

    MDIcon:
        icon: root.icon
        halign: "center"
        valign: "middle"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "22sp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

<StepHeader3D@MDBoxLayout>:
    icon: "camera-iris"
    title_text: ""
    subtitle_text: ""
    adaptive_height: True
    spacing: dp(14)

    StepBadge3D:
        icon: root.icon

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: root.title_text
            bold: True
            font_style: "Subtitle1"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            adaptive_height: True

        MDLabel:
            text: root.subtitle_text
            theme_text_color: "Custom"
            text_color: 0.65, 0.75, 0.85, 1
            font_style: "Caption"
            adaptive_height: True

<Button3D@ButtonBehavior+MDBoxLayout>:
    text: ""
    icon: "camera"
    btn_color: 0.12, 0.72, 0.48, 1
    shadow_color: 0.05, 0.40, 0.25, 1
    size_hint_y: None
    height: dp(48)
    padding: dp(14), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: root.shadow_color
        RoundedRectangle:
            pos: self.x, self.y - dp(3.5)
            size: self.size
            radius: [14,]
        Color:
            rgba: root.btn_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14,]
        Color:
            rgba: 1, 1, 1, 0.22
        RoundedRectangle:
            pos: self.x + dp(4), self.top - dp(8)
            size: self.width - dp(8), dp(4)
            radius: [3,]

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "20sp"
        size_hint: None, None
        size: dp(22), dp(22)
        pos_hint: {"center_y": 0.5}

    MDLabel:
        text: root.text
        bold: True
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "Button"
        pos_hint: {"center_y": 0.5}

<AnalyzeButton3D@ButtonBehavior+MDBoxLayout>:
    text: "ANALIZAR PLANTA CON IA"
    disabled: False
    size_hint_y: None
    height: dp(54)
    padding: dp(16), 0
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.55
        RoundedRectangle:
            pos: self.x, self.y - dp(4)
            size: self.size
            radius: [16,]
        Color:
            rgba: (0.06, 0.45, 0.28, 1) if not root.disabled else (0.15, 0.18, 0.22, 1)
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [16,]
        Color:
            rgba: (0.14, 0.85, 0.55, 1) if not root.disabled else (0.22, 0.26, 0.32, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16,]
        Color:
            rgba: (1, 1, 1, 0.3) if not root.disabled else (1, 1, 1, 0.05)
        RoundedRectangle:
            pos: self.x + dp(6), self.top - dp(10)
            size: self.width - dp(12), dp(5)
            radius: [4,]

    MDIcon:
        icon: "radar"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "24sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"center_y": 0.5}

    MDLabel:
        text: root.text
        bold: True
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "Subtitle2"
        pos_hint: {"center_y": 0.5}

<RoundIconButton>:
    icon: "volume-high"
    bg_color: 0.12, 0.75, 0.50, 1
    size_hint: None, None
    size: dp(48), dp(48)
    opacity: 0.4 if self.disabled else 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.35
        Ellipse:
            pos: self.x, self.y - dp(3)
            size: self.size
        Color:
            rgba: root.bg_color
        Ellipse:
            pos: self.pos
            size: self.size

    MDIcon:
        icon: root.icon
        halign: "center"
        valign: "middle"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "22sp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

<PlanOptionCard@ButtonBehavior+MDBoxLayout>:
    titulo: ""
    precio: ""
    descripcion: ""
    es_destacado: False
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(4)
    size_hint_y: None
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.45
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [16,]
        Color:
            rgba: (0.95, 0.75, 0.20, 0.7) if root.es_destacado else (0.18, 0.85, 0.55, 0.25)
        Line:
            width: 1.5 if root.es_destacado else 1
            rounded_rectangle: [self.x, self.y, self.width, self.height, 16]
        Color:
            rgba: (0.12, 0.10, 0.06, 1) if root.es_destacado else (0.07, 0.09, 0.14, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16,]

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(8)

        MDLabel:
            text: root.titulo
            bold: True
            font_style: "Subtitle1"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            adaptive_height: True

        MDLabel:
            text: root.precio
            bold: True
            font_style: "H6"
            halign: "right"
            theme_text_color: "Custom"
            text_color: (0.95, 0.75, 0.20, 1) if root.es_destacado else (0.20, 0.95, 0.60, 1)
            adaptive_height: True

    MDLabel:
        text: root.descripcion
        theme_text_color: "Custom"
        text_color: 0.75, 0.80, 0.85, 1
        font_style: "Caption"
        adaptive_height: True

<NavButton@ButtonBehavior+MDBoxLayout>:
    icon: "home-outline"
    text: ""
    active: False
    orientation: "vertical"
    spacing: dp(2)
    padding: dp(4)

    FloatLayout:
        size_hint_y: None
        height: dp(24)

        MDIcon:
            icon: root.icon
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: (0.22, 0.92, 0.60, 1) if root.active else (0.50, 0.55, 0.62, 1)
            font_size: "22sp"

    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: (0.22, 0.92, 0.60, 1) if root.active else (0.50, 0.55, 0.62, 1)
        bold: root.active
        adaptive_height: True

<ProTipCard3D@MDBoxLayout>:
    icon: "shield-check"
    title: ""
    desc: ""
    adaptive_height: True
    padding: dp(12)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: 0.08, 0.10, 0.14, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14,]
        Color:
            rgba: 0.15, 0.60, 0.40, 0.25
        Line:
            width: 1
            rounded_rectangle: [self.x, self.y, self.width, self.height, 14]

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 0.22, 0.92, 0.60, 1
        font_size: "24sp"
        size_hint_x: None
        width: dp(30)
        pos_hint: {"center_y": 0.5}

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(1)
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: root.title
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_style: "Caption"
            adaptive_height: True

        MDLabel:
            text: root.desc
            theme_text_color: "Custom"
            text_color: 0.70, 0.75, 0.82, 1
            font_style: "Caption"
            adaptive_height: True

# ---------------------------------------------------------------------------
# Layout Raíz
# ---------------------------------------------------------------------------

<RootLayout@MDBoxLayout>:
    orientation: "vertical"

    ScreenManager:
        id: sm

        HomeScreen:
        MainScreen:
        HistoryScreen:
        RecargarConsultasScreen:
        YapePagoScreen:
        AgroveterinariasScreen:
        AdminScreen:
        TipsScreen:
        MoreScreen:

    MDBoxLayout:
        size_hint_y: None
        height: dp(66)
        padding: dp(6), 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.6
            RoundedRectangle:
                pos: self.x, self.y + dp(3)
                size: self.size
                radius: [22, 22, 0, 0]
            Color:
                rgba: 0.05, 0.07, 0.11, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [22, 22, 0, 0]

        MDBoxLayout:
            NavButton:
                icon: "home-variant"
                text: "Inicio"
                active: app.current_tab == "home"
                on_release: app.go_home()

            NavButton:
                icon: "clipboard-pulse-outline"
                text: "Historial"
                active: app.current_tab == "history"
                on_release: app.go_history()

            FloatLayout:
                size_hint_x: None
                width: dp(64)

                MDFloatingActionButton:
                    icon: "camera"
                    md_bg_color: 0.14, 0.85, 0.55, 1
                    pos_hint: {"center_x": 0.5, "center_y": 0.62}
                    on_release: app.go_diagnosis()

            NavButton:
                icon: "store-marker-outline"
                text: "Agrovets"
                active: app.current_tab == "agrovets"
                on_release: app.go_agrovets()

            NavButton:
                icon: "dots-horizontal"
                text: "Más"
                active: app.current_tab == "more"
                on_release: app.go_more()

# ---------------------------------------------------------------------------
# Pantalla INICIO
# ---------------------------------------------------------------------------

<HomeScreen>:
    name: "home"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Agrowillay"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["sprout", lambda x: None]]
            right_action_items: [["shield-lock", lambda x: app.prompt_admin_code()]]

        # Barra Superior de Consultas
        MDBoxLayout:
            size_hint_y: None
            height: dp(38)
            padding: [dp(14), 0]
            canvas.before:
                Color:
                    rgba: 0.07, 0.11, 0.17, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIcon:
                icon: "ticket-percent-outline"
                theme_text_color: "Custom"
                text_color: 0.20, 0.95, 0.60, 1
                size_hint_x: None
                width: dp(26)
                pos_hint: {"center_y": 0.5}

            MDLabel:
                id: lbl_consultas_disponibles
                text: "🎁 Consultas disponibles: 10 restantes"
                theme_text_color: "Custom"
                text_color: 0.90, 0.95, 1, 1
                font_style: "Caption"
                bold: True
                pos_hint: {"center_y": 0.5}

            MDTextButton:
                text: "Recargar +"
                font_style: "Caption"
                bold: True
                theme_text_color: "Custom"
                text_color: 0.95, 0.75, 0.20, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.go_recargas()

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(10), dp(16), dp(28)]
                spacing: dp(16)

                # Banner Principal
                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(18), dp(16)
                    spacing: dp(14)
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.5
                        RoundedRectangle:
                            pos: self.x, self.y - dp(4)
                            size: self.size
                            radius: [20,]
                        Color:
                            rgba: 0.10, 0.58, 0.38, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20,]

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(3)
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "¡Hola, Agricultor!"
                            bold: True
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            adaptive_height: True

                        MDLabel:
                            text: "Diagnóstico fitosanitario con IA, seguimiento de plantas y agroveterinarias."
                            theme_text_color: "Custom"
                            text_color: 0.90, 0.98, 0.94, 1
                            font_style: "Caption"
                            adaptive_height: True

                    MDIcon:
                        icon: "shield-bug-outline"
                        font_size: "46sp"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.95
                        size_hint: None, None
                        size: dp(50), dp(50)
                        pos_hint: {"center_y": 0.5}

                # Clima Satelital y Alertas
                SectionCard3D:
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        StepHeader3D:
                            icon: "weather-partly-cloudy"
                            title_text: "Clima y Riesgo Agrícola"
                            subtitle_text: "Pronóstico y monitoreo de heladas"

                        RoundIconButton:
                            icon: "refresh"
                            bg_color: 0.15, 0.22, 0.30, 1
                            pos_hint: {"center_y": 0.5}
                            on_release: app.check_weather_alerts()

                    MDBoxLayout:
                        id: alerts_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: "Presiona el botón para consultar el pronóstico agrícola."
                            theme_text_color: "Custom"
                            text_color: 0.70, 0.75, 0.80, 1
                            adaptive_height: True

                MDLabel:
                    text: "Acciones Rápidas"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    adaptive_height: True

                MDGridLayout:
                    cols: 2
                    spacing: dp(12)
                    adaptive_height: True

                    Button3D:
                        text: "Tomar Foto"
                        icon: "camera"
                        btn_color: 0.10, 0.65, 0.42, 1
                        shadow_color: 0.05, 0.40, 0.24, 1
                        on_release: app.home_take_photo()

                    Button3D:
                        text: "Subir Foto"
                        icon: "image-multiple"
                        btn_color: 0.16, 0.32, 0.50, 1
                        shadow_color: 0.08, 0.18, 0.32, 1
                        on_release: app.home_choose_gallery()

                    Button3D:
                        text: "Historial"
                        icon: "clipboard-pulse"
                        btn_color: 0.20, 0.55, 0.65, 1
                        shadow_color: 0.10, 0.35, 0.45, 1
                        on_release: app.go_history()

                    Button3D:
                        text: "Agrovets"
                        icon: "store"
                        btn_color: 0.65, 0.35, 0.15, 1
                        shadow_color: 0.40, 0.20, 0.08, 1
                        on_release: app.go_agrovets()

# ---------------------------------------------------------------------------
# Pantalla DIAGNÓSTICO
# ---------------------------------------------------------------------------

<MainScreen>:
    name: "main"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Diagnóstico Inteligente"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            right_action_items: [["help-circle-outline", lambda x: app.show_help_dialog()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(8), dp(16), dp(32)]
                spacing: dp(16)

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    pos_hint: {"center_x": 0.5}

                    MDIcon:
                        icon: "circle-slice-8"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        font_size: "14sp"
                        size_hint: None, None
                        size: dp(14), dp(14)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "MODELO FITOSANITARIO GEMINI IA ACTIVO"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        adaptive_height: True
                        pos_hint: {"center_y": 0.5}

                SectionCard3D:
                    StepHeader3D:
                        icon: "camera-iris"
                        title_text: "Paso 1: Captura de la Planta"
                        subtitle_text: "Apunta a la hoja, tallo o fruto dañado"

                    FloatLayout:
                        size_hint_y: None
                        height: dp(230)

                        canvas.before:
                            Color:
                                rgba: 0, 0, 0, 0.65
                            RoundedRectangle:
                                pos: self.x, self.y - dp(4)
                                size: self.size
                                radius: [18,]
                            Color:
                                rgba: 0.05, 0.07, 0.11, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [18,]
                            Color:
                                rgba: 0.15, 0.70, 0.50, 0.35
                            Line:
                                width: 1.2
                                rounded_rectangle: [self.x, self.y, self.width, self.height, 18]
                            Color:
                                rgba: 0.20, 0.95, 0.65, 0.95
                            Line:
                                width: 2.4
                                points: [self.x + dp(14), self.top - dp(32), self.x + dp(14), self.top - dp(14), self.x + dp(32), self.top - dp(14)]
                            Line:
                                width: 2.4
                                points: [self.right - dp(32), self.top - dp(14), self.right - dp(14), self.top - dp(14), self.right - dp(14), self.top - dp(32)]
                            Line:
                                width: 2.4
                                points: [self.x + dp(14), self.y + dp(32), self.x + dp(14), self.y + dp(14), self.x + dp(32), self.y + dp(14)]
                            Line:
                                width: 2.4
                                points: [self.right - dp(32), self.y + dp(14), self.right - dp(14), self.y + dp(14), self.right - dp(14), self.y + dp(32)]

                        Image:
                            id: preview_image
                            size_hint: 0.94, 0.92
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            allow_stretch: True
                            keep_ratio: True
                            opacity: 1

                        MDBoxLayout:
                            id: preview_placeholder
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(260), dp(100)
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            spacing: dp(8)

                            MDIcon:
                                icon: "image-filter-center-focus"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: 0.20, 0.85, 0.55, 0.7
                                font_size: "46sp"

                            MDLabel:
                                text: "VISOR DE ESCANEO LISTO"
                                bold: True
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 0.9
                                font_style: "Caption"
                                adaptive_height: True

                            MDLabel:
                                text: "Toma una foto clara o sube una imagen de tu galería"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: 0.65, 0.70, 0.78, 1
                                font_style: "Caption"
                                adaptive_height: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        Button3D:
                            text: "Tomar Foto"
                            icon: "camera"
                            btn_color: 0.10, 0.65, 0.42, 1
                            shadow_color: 0.05, 0.40, 0.24, 1
                            size_hint_x: 0.5
                            on_release: app.take_photo()

                        Button3D:
                            text: "Galería"
                            icon: "image-multiple"
                            btn_color: 0.16, 0.32, 0.50, 1
                            shadow_color: 0.08, 0.18, 0.32, 1
                            size_hint_x: 0.5
                            on_release: app.choose_from_gallery()

                    AnalyzeButton3D:
                        id: analyze_btn
                        disabled: True
                        on_release: app.analyze_photo()

                    MDSpinner:
                        id: analyze_spinner
                        size_hint: None, None
                        size: dp(28), dp(28)
                        active: False
                        opacity: 0
                        pos_hint: {"center_x": 0.5}
                        color: 0.20, 0.95, 0.60, 1

                MDLabel:
                    text: "Guía de Captura para Mayor Precisión"
                    bold: True
                    font_style: "Subtitle2"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    adaptive_height: True

                ProTipCard3D:
                    icon: "white-balance-sunny"
                    title: "Buena Iluminación Natural"
                    desc: "Evita sombras pronunciadas sobre la hoja para que la IA distinga manchas de hongos y ácaros."

                ProTipCard3D:
                    icon: "image-filter-tilt-shift"
                    title: "Distancia Óptima: 10 a 20 cm"
                    desc: "Enfoca bien la parte dañada y el envés donde se concentran pulgones y larvas."

                SectionCard3D:
                    id: result_card
                    opacity: 0
                    disabled: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        StepHeader3D:
                            icon: "clipboard-pulse-outline"
                            title_text: "Diagnóstico Fitosanitario"
                            subtitle_text: "Análisis y tratamiento generado por la IA"

                        RoundIconButton:
                            id: speak_btn
                            icon: "volume-high"
                            pos_hint: {"center_y": 0.5}
                            on_release: app.speak_diagnosis(app.last_diagnosis)

                        RoundIconButton:
                            id: speak_qu_btn
                            icon: "translate"
                            bg_color: 0.85, 0.50, 0.15, 1
                            pos_hint: {"center_y": 0.5}
                            on_release: app.speak_diagnosis_quechua(app.last_diagnosis)

                    MDBoxLayout:
                        id: result_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

                SectionCard3D:
                    id: locator_card
                    opacity: 0
                    disabled: True

                    StepHeader3D:
                        icon: "storefront-outline"
                        title_text: "Agroveterinarias Cercanas"
                        subtitle_text: "Consigue los insumos para tratar tu cultivo"

                    Button3D:
                        text: "Ver Agroveterinarias Registradas"
                        icon: "store"
                        btn_color: 0.12, 0.70, 0.45, 1
                        shadow_color: 0.06, 0.40, 0.25, 1
                        size_hint_x: 1
                        on_release: app.go_agrovets()

# ---------------------------------------------------------------------------
# Pantalla HISTORIAL con Alertas y Pregunta de Recuperación
# ---------------------------------------------------------------------------

<HistoryScreen>:
    name: "history"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Historial y Monitoreo"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
            right_action_items: [["bell-ring-outline", lambda x: app.show_notification_info()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(12), dp(16), dp(30)]
                spacing: dp(14)

                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(14)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 0.08, 0.10, 0.15, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [16,]
                        Color:
                            rgba: 0.20, 0.85, 0.55, 0.25
                        Line:
                            width: 1
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 16]

                    MDIcon:
                        icon: "bell-alert"
                        theme_text_color: "Custom"
                        text_color: 0.95, 0.75, 0.20, 1
                        size_hint_x: None
                        width: dp(28)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Las plantas con severidad MEDIA o ALTA envían alertas hasta que confirmes que ya fueron tratadas y están sanas."
                        theme_text_color: "Custom"
                        text_color: 0.85, 0.88, 0.92, 1
                        font_style: "Caption"
                        adaptive_height: True

                MDBoxLayout:
                    id: history_placeholder
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                    padding: dp(20), dp(40)

                    MDIcon:
                        icon: "clipboard-text-clock-outline"
                        font_size: "54sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.55, 1

                    MDLabel:
                        text: "Aún no tienes diagnósticos registrados"
                        halign: "center"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        adaptive_height: True

                MDBoxLayout:
                    id: history_body
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(12)

# ---------------------------------------------------------------------------
# Pantalla RECARGAR CONSULTAS
# ---------------------------------------------------------------------------

<RecargarConsultasScreen>:
    name: "recargas"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Recargar Consultas"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(12), dp(16), dp(30)]
                spacing: dp(14)

                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(14)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 0.08, 0.12, 0.18, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14,]

                    MDIcon:
                        icon: "information-outline"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        size_hint_x: None
                        width: dp(26)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Elige el paquete que prefieras. Pagas por Yape y tus consultas se activan de inmediato."
                        theme_text_color: "Custom"
                        text_color: 0.85, 0.88, 0.95, 1
                        font_style: "Caption"
                        adaptive_height: True

                PlanOptionCard:
                    titulo: "Paquete 50 Consultas"
                    precio: "S/ 6.00"
                    descripcion: "Perfecto para revisar tu chacra o huerto en la semana."
                    on_release: app.seleccionar_paquete_yape("50 Consultas", "S/ 6.00", 50)

                PlanOptionCard:
                    titulo: "Paquete 100 Consultas"
                    precio: "S/ 10.00"
                    descripcion: "El más elegido por los agricultores. Consultas para todo el mes."
                    es_destacado: True
                    on_release: app.seleccionar_paquete_yape("100 Consultas", "S/ 10.00", 100)

                PlanOptionCard:
                    titulo: "Paquete 250 Consultas"
                    precio: "S/ 20.00"
                    descripcion: "Para productores con varias parcelas y cultivos extensos."
                    on_release: app.seleccionar_paquete_yape("250 Consultas", "S/ 20.00", 250)

                PlanOptionCard:
                    titulo: "Mes Completo ILIMITADO"
                    precio: "S/ 15.00"
                    descripcion: "Haz todas las consultas que necesites durante 30 días sin límites."
                    es_destacado: True
                    on_release: app.seleccionar_paquete_yape("1 Mes Ilimitado", "S/ 15.00", -1)

                SectionCard3D:
                    MDLabel:
                        text: "¿Ya tienes un código de recarga?"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                    MDTextField:
                        id: input_codigo_recarga
                        hint_text: "Escribe tu código aquí (Ej: AGRO-100)"
                        mode: "fill"

                    Button3D:
                        text: "ACTIVAR CÓDIGO"
                        icon: "ticket-confirmation"
                        btn_color: 0.12, 0.72, 0.48, 1
                        on_release: app.canjear_codigo(input_codigo_recarga.text)

# ---------------------------------------------------------------------------
# Pantalla PAGO CON TU QR DE YAPE
# ---------------------------------------------------------------------------

<YapePagoScreen>:
    name: "yape_pago"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Pagar con Yape"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_recargas()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(10), dp(16), dp(30)]
                spacing: dp(14)

                SectionCard3D:
                    MDLabel:
                        id: lbl_paquete_elegido
                        text: "Paquete Elegido: 100 Consultas"
                        bold: True
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        adaptive_height: True

                    MDLabel:
                        id: lbl_precio_elegido
                        text: "Monto a Yapear: S/ 10.00"
                        bold: True
                        font_style: "H5"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        adaptive_height: True

                    FloatLayout:
                        size_hint_y: None
                        height: dp(260)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [16,]

                        Image:
                            id: img_qr_yape
                            source: "qr_yape.png"
                            size_hint: 0.92, 0.92
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            allow_stretch: True
                            keep_ratio: True

                    MDLabel:
                        text: "1. Abre tu aplicación Yape en el celular.\n2. Escanea este código o toma una captura de pantalla a este QR.\n3. Una vez yapeado, presiona el botón verde de abajo para avisarnos por WhatsApp y activar tus consultas al instante."
                        theme_text_color: "Custom"
                        text_color: 0.85, 0.90, 0.95, 1
                        font_style: "Caption"
                        adaptive_height: True

                    Button3D:
                        text: "ENVIAR COMPROBANTE POR WHATSAPP"
                        icon: "whatsapp"
                        btn_color: 0.10, 0.75, 0.45, 1
                        shadow_color: 0.05, 0.45, 0.25, 1
                        on_release: app.notificar_pago_whatsapp()

                    Button3D:
                        text: "SUBIR CAPTURA DEL YAPE"
                        icon: "image-check"
                        btn_color: 0.16, 0.32, 0.50, 1
                        shadow_color: 0.08, 0.18, 0.32, 1
                        on_release: app.subir_voucher_galeria()

