# ---------------------------------------------------------------------------
# Pantalla ADMIN---
# ---------------------------------------------------------------------------

<AdminScreen>:
    name: "admin"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "ADMIN--- Gestión"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_more()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(12), dp(16), dp(30)]
                spacing: dp(16)

                SectionCard3D:
                    StepHeader3D:
                        icon: "ticket-percent"
                        title_text: "Generar Códigos para Clientes"
                        subtitle_text: "Crea códigos PIN para los agricultores que pagaron"

                    Button3D:
                        text: "GENERAR CÓDIGO (100 CONSULTAS)"
                        icon: "ticket"
                        on_release: app.admin_generar_codigo(100)

                    Button3D:
                        text: "GENERAR CÓDIGO (MES ILIMITADO)"
                        icon: "crown"
                        btn_color: 0.65, 0.35, 0.15, 1
                        on_release: app.admin_generar_codigo(-1)

                SectionCard3D:
                    StepHeader3D:
                        icon: "shield-account"
                        title_text: "Registrar Agroveterinaria"
                        subtitle_text: "Será visible en el directorio para los agricultores"

                    MDTextField:
                        id: admin_input_nombre
                        hint_text: "Nombre del Establecimiento *"
                        mode: "fill"

                    MDTextField:
                        id: admin_input_ciudad
                        hint_text: "Dirección / Ciudad / Distrito *"
                        mode: "fill"

                    MDTextField:
                        id: admin_input_telefono
                        hint_text: "Teléfono de Llamada *"
                        input_type: "tel"
                        mode: "fill"

                    MDTextField:
                        id: admin_input_whatsapp
                        hint_text: "Número de WhatsApp (Ej: 51987654321) *"
                        input_type: "tel"
                        mode: "fill"

                    MDTextField:
                        id: admin_input_notas
                        hint_text: "Insumos destacados (Opcional)"
                        mode: "fill"

                    Button3D:
                        text: "REGISTRAR AGROVETERINARIA"
                        icon: "check-bold"
                        btn_color: 0.12, 0.72, 0.48, 1
                        shadow_color: 0.05, 0.40, 0.25, 1
                        on_release: app.admin_save_agroveterinaria()

                MDLabel:
                    text: "Establecimientos Guardados"
                    bold: True
                    font_style: "H6"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    adaptive_height: True

                MDBoxLayout:
                    id: admin_agrovets_list
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(12)

