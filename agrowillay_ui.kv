#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior

RootLayout:

# ---------------------------------------------------------------------------
# Piezas de diseno reutilizables
# ---------------------------------------------------------------------------

<StepBadge@FloatLayout>:
    icon: "numeric-1"
    size_hint: None, None
    size: dp(44), dp(44)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.12
        Ellipse:
            pos: self.x - dp(1), self.y - dp(3)
            size: self.size
        Color:
            rgba: app.theme_color
        Ellipse:
            pos: self.pos
            size: self.size

    MDIcon:
        icon: root.icon
        halign: "center"
        valign: "middle"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "22sp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

<StepHeader@MDBoxLayout>:
    icon: "numeric-1"
    title_text: ""
    subtitle_text: ""
    adaptive_height: True
    spacing: dp(14)

    StepBadge:
        icon: root.icon

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(3)

        MDLabel:
            text: root.title_text
            bold: True
            font_style: "Subtitle1"
            adaptive_height: True

        MDLabel:
            text: root.subtitle_text
            theme_text_color: "Secondary"
            font_style: "Caption"
            adaptive_height: True

<SectionCard@MDBoxLayout>:
    orientation: "vertical"
    padding: dp(20)
    spacing: dp(16)
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.08
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [22,]
        Color:
            rgba: 0.09, 0.075, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [22,]

<PillButton@MDRaisedButton>:
    md_bg_color: app.theme_color
    text_color: 1, 1, 1, 1
    elevation: 0
    size_hint_x: 1
    height: dp(50)
    font_size: "15sp"

<GhostButton@MDFlatButton>:
    md_bg_color: 0.925, 0.965, 0.949, 1
    text_color: app.theme_color
    elevation: 0
    size_hint_x: 1
    height: dp(50)
    font_size: "15sp"

<WelcomeStrip@MDBoxLayout>:
    adaptive_height: True
    padding: dp(18), dp(14)
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: app.theme_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,]
        Color:
            rgba: 1, 1, 1, 0.06
        Ellipse:
            pos: self.right - dp(70), self.top - dp(55)
            size: dp(100), dp(100)

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: "Hola, bienvenido"
            bold: True
            font_style: "Subtitle1"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            adaptive_height: True

        MDLabel:
            text: "Identifica plagas al instante con IA"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 0.85
            font_style: "Caption"
            adaptive_height: True

    Image:
        source: "illustrations/potted_plant.png"
        size_hint: None, None
        size: dp(66), dp(66)
        pos_hint: {"center_y": 0.5}
        allow_stretch: True
        keep_ratio: True
<SeverityChip@MDBoxLayout>:
    text: ""
    chip_color: 0.77, 0.5, 0.1, 1
    adaptive_size: True
    padding: dp(16), dp(7)
    canvas.before:
        Color:
            rgba: root.chip_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16),]

    MDLabel:
        text: root.text
        bold: True
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "Caption"
        adaptive_size: True

<IconRow@MDBoxLayout>:
    icon: "check-circle-outline"
    icon_color: 0, 0, 0, 1
    text: ""
    adaptive_height: True
    spacing: dp(10)
    padding: 0, dp(4)

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: root.icon_color
        font_size: "20sp"
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {"top": 1}

    MDLabel:
        text: root.text
        markup: True
        adaptive_height: True

<RoundIconButton@ButtonBehavior+FloatLayout>:
    icon: "volume-high"
    size_hint: None, None
    size: dp(52), dp(52)
    opacity: 0.4 if self.disabled else 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.12
        Ellipse:
            pos: self.x - dp(1), self.y - dp(3)
            size: self.size
        Color:
            rgba: app.theme_color
        Ellipse:
            pos: self.pos
            size: self.size

    MDIcon:
        icon: root.icon
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "24sp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

# Tarjeta de "Acciones rapidas" en Inicio: icono + titulo + subtitulo,
# con ripple al tocar.
<QuickAction@ButtonBehavior+MDBoxLayout>:
    icon: "camera-outline"
    icon_bg: 0.90, 0.96, 0.93, 1
    title_text: ""
    subtitle_text: ""
    orientation: "vertical"
    size_hint_y: None
    height: dp(118)
    padding: dp(14)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.08
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [18,]
        Color:
            rgba: 0.09, 0.075, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18,]

    FloatLayout:
        size_hint: None, None
        size: dp(38), dp(38)
        canvas.before:
            Color:
                rgba: root.icon_bg
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [12,]

        MDIcon:
            icon: root.icon
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: app.theme_color
            font_size: "20sp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    MDLabel:
        text: root.title_text
        bold: True
        font_style: "Body2"
        adaptive_height: True

    MDLabel:
        text: root.subtitle_text
        theme_text_color: "Secondary"
        font_style: "Caption"
        adaptive_height: True

# Tarjeta pequena numerada para "Como funciona"
<MiniStepCard@MDBoxLayout>:
    number: "1"
    icon: "camera-outline"
    text: ""
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(8)
    padding: dp(12)
    canvas.before:
        Color:
            rgba: 0.965, 0.975, 0.968, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16,]

    MDBoxLayout:
        adaptive_size: True
        spacing: dp(6)

        FloatLayout:
            size_hint: None, None
            size: dp(22), dp(22)
            canvas.before:
                Color:
                    rgba: app.theme_color
                Ellipse:
                    pos: self.pos
                    size: self.size

            MDLabel:
                text: root.number
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
                font_style: "Caption"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

        MDIcon:
            icon: root.icon
            theme_text_color: "Custom"
            text_color: app.theme_color
            font_size: "20sp"

    MDLabel:
        text: root.text
        font_style: "Caption"
        adaptive_height: True

# Item de texto simple para pantallas Consejos / Mas
<SimpleTip@MDBoxLayout>:
    icon: "leaf"
    title_text: ""
    body_text: ""
    orientation: "vertical"
    adaptive_height: True
    padding: dp(18)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.06
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [18,]
        Color:
            rgba: 0.09, 0.075, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18,]

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(10)

        MDIcon:
            icon: root.icon
            theme_text_color: "Custom"
            text_color: app.theme_color
            font_size: "22sp"
            size_hint_x: None
            width: dp(28)

        MDLabel:
            text: root.title_text
            bold: True
            font_style: "Subtitle2"
            adaptive_height: True

    MDLabel:
        text: root.body_text
        theme_text_color: "Secondary"
        adaptive_height: True

# Boton de la lista "Mas" (Ajustes, Idioma, Acerca de...)
<MoreListItem@ButtonBehavior+MDBoxLayout>:
    icon: "cog-outline"
    text: ""
    adaptive_height: True
    padding: dp(6), dp(14)
    spacing: dp(16)

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: app.theme_color
        font_size: "22sp"
        size_hint_x: None
        width: dp(28)

    MDLabel:
        text: root.text
        adaptive_height: True
        pos_hint: {"center_y": 0.5}

    MDIcon:
        icon: "chevron-right"
        theme_text_color: "Hint"
        size_hint_x: None
        width: dp(24)

# Boton de la barra de navegacion inferior
<NavButton@ButtonBehavior+MDBoxLayout>:
    icon: "home-outline"
    text: ""
    active: False
    orientation: "vertical"
    spacing: dp(2)
    padding: dp(4)

    MDIcon:
        icon: root.icon
        halign: "center"
        text_size: self.width, None
        theme_text_color: "Custom"
        text_color: app.theme_color if root.active else (0.6, 0.63, 0.61, 1)
        font_size: "22sp"

    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: app.theme_color if root.active else (0.6, 0.63, 0.61, 1)
        bold: root.active
        adaptive_height: True

# ---------------------------------------------------------------------------
# Layout raiz: ScreenManager + barra de navegacion inferior persistente
# ---------------------------------------------------------------------------

<RootLayout@MDBoxLayout>:
    orientation: "vertical"

    ScreenManager:
        id: sm

        HomeScreen:
        MainScreen:
        HistoryScreen:
        TipsScreen:
        MoreScreen:

    MDBoxLayout:
        size_hint_y: None
        height: dp(68)
        padding: dp(4), 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.1
            RoundedRectangle:
                pos: self.x, self.y + dp(2)
                size: self.size
                radius: [22, 22, 0, 0]
            Color:
                rgba: 0.09, 0.075, 0.13, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [22, 22, 0, 0]

        MDBoxLayout:

            NavButton:
                icon: "home-variant"
                text: "Inicio"
                active: app.current_tab == "home"
                on_release: app.go_home()

            NavButton:
                icon: "clipboard-text-outline"
                text: "Diagnosticos"
                active: app.current_tab == "history"
                on_release: app.go_history()

            FloatLayout:
                size_hint_x: None
                width: dp(64)

                RoundIconButton:
                    icon: "leaf"
                    pos_hint: {"center_x": 0.5, "center_y": 0.6}
                    on_release: app.go_diagnosis()

            NavButton:
                icon: "lightbulb-outline"
                text: "Consejos"
                active: app.current_tab == "tips"
                on_release: app.go_tips()

            NavButton:
                icon: "dots-horizontal"
                text: "Mas"
                active: app.current_tab == "more"
                on_release: app.go_more()

# ---------------------------------------------------------------------------
# Pantalla INICIO
# ---------------------------------------------------------------------------

<HomeScreen>:
    name: "home"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.043, 0.035, 0.07, 1

        MDTopAppBar:
            title: "Agrowillay"
            elevation: 0
            md_bg_color: app.theme_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["leaf", lambda x: None]]
            right_action_items: [["dots-horizontal", lambda x: app.go_more()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(20), dp(16), dp(24)]
                spacing: dp(20)

                WelcomeStrip:

                MDLabel:
                    text: "Acciones rapidas"
                    font_style: "H6"
                    bold: True
                    adaptive_height: True

                MDGridLayout:
                    cols: 2
                    spacing: dp(12)
                    adaptive_height: True

                    QuickAction:
                        icon: "camera-outline"
                        icon_bg: 0.90, 0.96, 0.93, 1
                        title_text: "Tomar foto"
                        subtitle_text: "Con camara"
                        on_release: app.home_take_photo()

                    QuickAction:
                        icon: "image-multiple-outline"
                        icon_bg: 0.90, 0.96, 0.93, 1
                        title_text: "Subir imagen"
                        subtitle_text: "De galeria"
                        on_release: app.home_choose_gallery()

                    QuickAction:
                        icon: "clipboard-text-outline"
                        icon_bg: 0.98, 0.94, 0.85, 1
                        title_text: "Mis diagnosticos"
                        subtitle_text: "Ver historial"
                        on_release: app.go_history()

                    QuickAction:
                        icon: "map-marker-radius-outline"
                        icon_bg: 0.87, 0.92, 0.99, 1
                        title_text: "Ayuda cercana"
                        subtitle_text: "Viveros y tiendas"
                        on_release: app.home_show_help()

                Image:
                    source: "illustrations/potted_plant.png"
                    size_hint_y: None
                    height: dp(120)
                    allow_stretch: True
                    keep_ratio: True

                SimpleTip:
                    icon: "leaf"
                    title_text: "Consejo del dia"
                    body_text: "Revisa regularmente el enves de las hojas, ahi suelen esconderse muchas plagas."

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)

                    Image:
                        source: "illustrations/glow_sphere.png"
                        size_hint: None, None
                        size: dp(36), dp(36)
                        allow_stretch: True
                        keep_ratio: True

                    MDLabel:
                        text: "Como funciona?"
                        font_style: "H6"
                        bold: True
                        adaptive_height: True
                        valign: "middle"

                MDGridLayout:
                    cols: 2
                    spacing: dp(12)
                    adaptive_height: True

                    MiniStepCard:
                        number: "1"
                        icon: "camera-outline"
                        text: "Toma o sube una foto clara"

                    MiniStepCard:
                        number: "2"
                        icon: "magnify-scan"
                        text: "La IA analiza la imagen"

                    MiniStepCard:
                        number: "3"
                        icon: "shield-check-outline"
                        text: "Recibe el diagnostico y causa"

                    MiniStepCard:
                        number: "4"
                        icon: "sprout-outline"
                        text: "Obten un plan de tratamiento"

# ---------------------------------------------------------------------------
# Pantalla DIAGNOSTICO (paso a paso: foto -> analisis -> ayuda cercana)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Piezas exclusivas de la pantalla Diagnostico (tema morado oscuro)
# ---------------------------------------------------------------------------

<DiagBadge@MDBoxLayout>:
    icon: "shield-check-outline"
    text: ""
    adaptive_size: True
    spacing: dp(6)

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 0.68, 0.56, 0.98, 1
        font_size: "15sp"
        adaptive_size: True

    MDLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: 0.82, 0.78, 0.92, 1
        font_style: "Caption"
        adaptive_size: True

<DarkCard@MDBoxLayout>:
    orientation: "vertical"
    padding: dp(20)
    spacing: dp(16)
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0.09, 0.075, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [22,]

<DiagCaptureRow@ButtonBehavior+MDBoxLayout>:
    icon: "camera"
    title_text: ""
    subtitle_text: ""
    icon_bg: 0.42, 0.29, 0.86, 1
    spacing: dp(12)
    padding: dp(12), dp(10)
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0.14, 0.12, 0.19, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14,]

    FloatLayout:
        size_hint: None, None
        size: dp(38), dp(38)
        canvas.before:
            Color:
                rgba: root.icon_bg
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [11,]

        MDIcon:
            icon: root.icon
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_size: "18sp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(1)
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: root.title_text
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_style: "Body2"
            adaptive_height: True

        MDLabel:
            text: root.subtitle_text
            theme_text_color: "Custom"
            text_color: 0.6, 0.58, 0.65, 1
            font_style: "Caption"
            adaptive_height: True

<GradientButton@ButtonBehavior+MDBoxLayout>:
    text: "ANALIZAR PLANTA"
    padding: dp(20), 0
    size_hint_y: None
    height: dp(54)
    canvas.before:
        Color:
            rgba: 0.94, 0.5, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [27,]
        Color:
            rgba: 0.82, 0.28, 0.4, 1
        RoundedRectangle:
            pos: self.x + self.width * 0.36, self.y
            size: self.width * 0.4, self.height
            radius: [4,]
        Color:
            rgba: 0.5, 0.32, 0.88, 1
        RoundedRectangle:
            pos: self.x + self.width * 0.66, self.y
            size: self.width * 0.34, self.height
            radius: [4, 27, 27, 4]

    MDLabel:
        text: root.text
        bold: True
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "Body1"

    FloatLayout:
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.35
            Ellipse:
                pos: self.pos
                size: self.size

        MDIcon:
            icon: "arrow-right"
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_size: "18sp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

<DiagIconBtn@ButtonBehavior+FloatLayout>:
    icon: "arrow-left"
    bg_color: 0.14, 0.12, 0.19, 1
    border_color: 0, 0, 0, 0
    size_hint: None, None
    size: dp(42), dp(42)
    canvas.before:
        Color:
            rgba: self.bg_color
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: self.border_color
        Line:
            width: 1.2
            circle: (self.center_x, self.center_y, self.width / 2 - 1)

    MDIcon:
        icon: root.icon
        halign: "center"
        valign: "middle"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "20sp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

<MainScreen>:
    name: "main"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.043, 0.035, 0.07, 1

        MDBoxLayout:
            size_hint_y: None
            height: dp(86)
            padding: dp(14), dp(16), dp(14), dp(6)
            spacing: dp(10)

            DiagIconBtn:
                icon: "arrow-left"
                pos_hint: {"center_y": 0.6}
                on_release: app.go_home()

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                pos_hint: {"center_y": 0.6}

                MDLabel:
                    text: "Diagnostico"
                    bold: True
                    font_style: "H6"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    adaptive_height: True

                MDLabel:
                    text: "Detecta plagas y enfermedades al instante"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.62, 0.6, 0.68, 1
                    font_style: "Caption"
                    adaptive_height: True

            DiagIconBtn:
                icon: "help-circle-outline"
                border_color: 0.5, 0.35, 0.9, 1
                pos_hint: {"center_y": 0.6}
                on_release: app.show_help_dialog()

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                id: content_box
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(6), dp(16), dp(30)]
                spacing: dp(18)

                # ---------------- HERO: mensaje + insignias ----------------
                DarkCard:

                    MDBoxLayout:
                        spacing: dp(14)
                        adaptive_height: True

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(8)
                            adaptive_height: True
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Cuida tus plantas,\n[color=8654e0]asegura tu cosecha[/color]"
                                markup: True
                                bold: True
                                font_style: "H6"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                adaptive_height: True

                            MDLabel:
                                text: "Toma o sube una foto y la IA analizara tu planta para darte un diagnostico preciso."
                                theme_text_color: "Custom"
                                text_color: 0.68, 0.66, 0.74, 1
                                font_style: "Caption"
                                adaptive_height: True

                            MDBoxLayout:
                                adaptive_size: True
                                spacing: dp(14)

                                DiagBadge:
                                    icon: "shield-check-outline"
                                    text: "Rapido"

                                DiagBadge:
                                    icon: "target"
                                    text: "Confiable"

                                DiagBadge:
                                    icon: "leaf"
                                    text: "Efectivo"

                        FloatLayout:
                            size_hint: None, None
                            size: dp(104), dp(104)
                            pos_hint: {"center_y": 0.5}

                            canvas.before:
                                Color:
                                    rgba: 0.35, 0.22, 0.75, 0.3
                                Ellipse:
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0.55, 0.4, 0.95, 0.5
                                Line:
                                    width: 1.3
                                    circle: (self.center_x, self.center_y, dp(50))
                                Color:
                                    rgba: 1, 1, 1, 0.85
                                Line:
                                    width: 1.5
                                    points: [self.x, self.y+dp(16), self.x, self.y, self.x+dp(16), self.y]
                                Line:
                                    width: 1.5
                                    points: [self.right-dp(16), self.y, self.right, self.y, self.right, self.y+dp(16)]
                                Line:
                                    width: 1.5
                                    points: [self.right, self.top-dp(16), self.right, self.top, self.right-dp(16), self.top]
                                Line:
                                    width: 1.5
                                    points: [self.x+dp(16), self.top, self.x, self.top, self.x, self.top-dp(16)]

                            MDIcon:
                                icon: "sprout"
                                halign: "center"
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: 0.55, 0.85, 0.6, 1
                                font_size: "44sp"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                # ---------------- PASO 1: FOTO ----------------
                DarkCard:

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        FloatLayout:
                            size_hint: None, None
                            size: dp(46), dp(46)
                            canvas.before:
                                Color:
                                    rgba: 0.42, 0.29, 0.86, 1
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                            MDIcon:
                                icon: "camera-outline"
                                halign: "center"
                                valign: "middle"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "20sp"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: dp(2)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Fotografia la planta"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                adaptive_height: True

                            MDLabel:
                                text: "Usa buena luz natural y enfoca la zona afectada."
                                theme_text_color: "Custom"
                                text_color: 0.6, 0.58, 0.65, 1
                                font_style: "Caption"
                                adaptive_height: True

                        Image:
                            source: "illustrations/magnifier_leaf.png"
                            size_hint: None, None
                            size: dp(44), dp(44)
                            allow_stretch: True
                            keep_ratio: True

                    FloatLayout:
                        size_hint_y: None
                        height: dp(215)

                        canvas.before:
                            Color:
                                rgba: 0.07, 0.06, 0.11, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [18,]
                            Color:
                                rgba: 0.4, 0.3, 0.8, 0.7
                            Line:
                                dash_length: 7
                                dash_offset: 4
                                width: 1.2
                                rounded_rectangle:
                                    [self.x + 1, self.y + 1, self.width - 2, self.height - 2, 18]

                        Image:
                            id: preview_image
                            size_hint: 0.94, 0.9
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            allow_stretch: True
                            keep_ratio: True
                            opacity: 1

                        MDBoxLayout:
                            id: preview_placeholder
                            orientation: "vertical"
                            size_hint: None, None
                            size: dp(230), dp(78)
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            spacing: dp(10)

                            MDIcon:
                                icon: "image-plus-outline"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: 0.5, 0.48, 0.58, 1
                                font_size: "38sp"

                            MDLabel:
                                text: "Aun no hay foto seleccionada"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: 0.5, 0.48, 0.58, 1
                                font_style: "Caption"
                                adaptive_height: True

                        DiagIconBtn:
                            icon: "close"
                            size_hint: None, None
                            size: dp(34), dp(34)
                            opacity: 1 if preview_image.opacity > 0.5 else 0
                            disabled: preview_image.opacity < 0.5
                            pos_hint: {"right": 0.97, "top": 0.95}
                            on_release: app.clear_photo()

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)

                        DiagCaptureRow:
                            icon: "camera"
                            title_text: "Tomar foto"
                            subtitle_text: "Con camara"
                            icon_bg: 0.42, 0.29, 0.86, 1
                            on_release: app.take_photo()

                        DiagCaptureRow:
                            icon: "image-multiple-outline"
                            title_text: "Subir imagen"
                            subtitle_text: "Desde galeria"
                            icon_bg: 0.75, 0.25, 0.55, 1
                            on_release: app.choose_from_gallery()

                    GradientButton:
                        id: analyze_btn
                        text: "ANALIZAR PLANTA"
                        disabled: True
                        opacity: 0.45 if self.disabled else 1
                        on_release: app.analyze_photo()

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)
                        pos_hint: {"center_x": 0.5}

                        MDSpinner:
                            id: analyze_spinner
                            size_hint: None, None
                            size: dp(22), dp(22)
                            active: False
                            opacity: 0
                            color: 0.6, 0.4, 0.95, 1

                    DiagCaptureRow:
                        icon: "chip"
                        title_text: "IA avanzada"
                        subtitle_text: "Diagnosticos precisos con recomendaciones personalizadas."
                        icon_bg: 0.75, 0.25, 0.55, 1

                # ---------------- PASO 2: DIAGNÓSTICO ----------------
                DarkCard:
                    id: result_card
                    opacity: 0
                    disabled: True

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        StepHeader:
                            icon: "clipboard-text-outline"
                            title_text: "Diagnostico"
                            subtitle_text: "Resultado generado por la IA a partir de tu foto."

                        RoundIconButton:
                            id: speak_btn
                            icon: "volume-high"
                            disabled: True
                            pos_hint: {"center_y": 0.5}
                            on_release: app.speak_diagnosis(app.last_diagnosis)

                    MDBoxLayout:
                        id: result_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

                # ---------------- PASO 3: AYUDA CERCANA ----------------
                DarkCard:
                    id: locator_card
                    opacity: 0
                    disabled: True

                    StepHeader:
                        icon: "map-marker-radius-outline"
                        title_text: "Ayuda cerca de ti"
                        subtitle_text: "Viveros, tiendas de jardineria y agronomos que pueden ayudarte."

                    MDBoxLayout:
                        id: locator_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

# ---------------------------------------------------------------------------
# Pantalla HISTORIAL ("Diagnosticos")
# ---------------------------------------------------------------------------

<HistoryScreen>:
    name: "history"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.043, 0.035, 0.07, 1

        MDTopAppBar:
            title: "Mis diagnosticos"
            elevation: 0
            md_bg_color: app.theme_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(20), dp(16), dp(30)]
                spacing: dp(16)

                MDBoxLayout:
                    id: history_placeholder
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                    padding: dp(20), dp(40)

                    Image:
                        source: "illustrations/robot_mascot.png"
                        size_hint: None, None
                        size: dp(140), dp(140)
                        pos_hint: {"center_x": 0.5}
                        allow_stretch: True
                        keep_ratio: True

                    MDLabel:
                        text: "Aun no tienes diagnosticos"
                        halign: "center"
                        bold: True
                        adaptive_height: True

                    MDLabel:
                        text: "Cuando analices una planta, el resultado aparecera aqui."
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_style: "Caption"
                        adaptive_height: True

                SectionCard:
                    id: history_last_card
                    opacity: 0
                    disabled: True

                    StepHeader:
                        icon: "clipboard-text-outline"
                        title_text: "Ultimo diagnostico"
                        subtitle_text: "Resultado de tu analisis mas reciente."

                    MDBoxLayout:
                        id: history_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

# ---------------------------------------------------------------------------
# Pantalla CONSEJOS
# ---------------------------------------------------------------------------

<TipsScreen>:
    name: "tips"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.043, 0.035, 0.07, 1

        MDTopAppBar:
            title: "Consejos"
            elevation: 0
            md_bg_color: app.theme_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(20), dp(16), dp(30)]
                spacing: dp(14)

                SimpleTip:
                    icon: "leaf"
                    title_text: "Revisa el enves de las hojas"
                    body_text: "Muchas plagas se esconden ahi y pasan desapercibidas si solo miras la superficie."

                SimpleTip:
                    icon: "weather-sunny"
                    title_text: "Riega temprano en la manana"
                    body_text: "Evita que el agua se quede en las hojas durante la noche, eso favorece los hongos."

                SimpleTip:
                    icon: "sprout-outline"
                    title_text: "Rota tus cultivos cada temporada"
                    body_text: "Ayuda a cortar el ciclo de plagas y enfermedades que quedan en el suelo."

                SimpleTip:
                    icon: "shield-check-outline"
                    title_text: "Prefiere el control biologico"
                    body_text: "Antes de usar quimicos fuertes, prueba metodos naturales o insectos beneficos."

                SimpleTip:
                    icon: "content-cut"
                    title_text: "Desinfecta tus herramientas de poda"
                    body_text: "Evita pasar enfermedades de una planta a otra al cortar ramas u hojas."

# ---------------------------------------------------------------------------
# Pantalla MAS (ajustes, idioma, acerca de, ayuda)
# ---------------------------------------------------------------------------

<MoreScreen>:
    name: "more"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.043, 0.035, 0.07, 1

        MDTopAppBar:
            title: "Mas opciones"
            elevation: 0
            md_bg_color: app.theme_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(8), dp(16), dp(8), dp(30)]
                spacing: dp(4)

                MoreListItem:
                    icon: "translate"
                    text: "Idioma (Espanol / Quechua)"
                    on_release: app.show_language_options()

                MoreListItem:
                    icon: "information-outline"
                    text: "Acerca de Agrowillay"
                    on_release: app.show_about_dialog()

                MoreListItem:
                    icon: "help-circle-outline"
                    text: "Ayuda"
                    on_release: app.show_help_dialog()
