#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior

RootLayout:

# ---------------------------------------------------------------------------
# Componentes 3D y Tarjetas de Relieve
# ---------------------------------------------------------------------------

<SectionCard3D@MDBoxLayout>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(12)
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.55
        RoundedRectangle:
            pos: self.x, self.y - dp(4)
            size: self.size
            radius: [20,]
        Color:
            rgba: 0.18, 0.85, 0.55, 0.3
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(1)
            size: self.width + dp(2), self.height + dp(2)
            radius: [21,]
        Color:
            rgba: 0.07, 0.09, 0.13, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20,]

<Button3D@ButtonBehavior+MDBoxLayout>:
    text: ""
    icon: "check"
    btn_color: 0.12, 0.72, 0.48, 1
    shadow_color: 0.05, 0.40, 0.25, 1
    size_hint_y: None
    height: dp(48)
    padding: dp(14), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: root.shadow_color
        RoundedRectangle:
            pos: self.x, self.y - dp(3.5)
            size: self.size
            radius: [14,]
        Color:
            rgba: root.btn_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14,]
        Color:
            rgba: 1, 1, 1, 0.22
        RoundedRectangle:
            pos: self.x + dp(4), self.top - dp(8)
            size: self.width - dp(8), dp(4)
            radius: [3,]

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "20sp"
        size_hint: None, None
        size: dp(22), dp(22)
        pos_hint: {"center_y": 0.5}

    MDLabel:
        text: root.text
        bold: True
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_style: "Button"
        pos_hint: {"center_y": 0.5}

<PlanOptionCard@ButtonBehavior+MDBoxLayout>:
    titulo: ""
    precio: ""
    descripcion: ""
    es_destacado: False
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(4)
    size_hint_y: None
    adaptive_height: True
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.45
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [16,]
        Color:
            rgba: (0.95, 0.75, 0.20, 0.7) if root.es_destacado else (0.18, 0.85, 0.55, 0.25)
        Line:
            width: 1.5 if root.es_destacado else 1
            rounded_rectangle: [self.x, self.y, self.width, self.height, 16]
        Color:
            rgba: (0.12, 0.10, 0.06, 1) if root.es_destacado else (0.07, 0.09, 0.14, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16,]

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(8)

        MDLabel:
            text: root.titulo
            bold: True
            font_style: "Subtitle1"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            adaptive_height: True

        MDLabel:
            text: root.precio
            bold: True
            font_style: "H6"
            halign: "right"
            theme_text_color: "Custom"
            text_color: (0.95, 0.75, 0.20, 1) if root.es_destacado else (0.20, 0.95, 0.60, 1)
            adaptive_height: True

    MDLabel:
        text: root.descripcion
        theme_text_color: "Custom"
        text_color: 0.75, 0.80, 0.85, 1
        font_style: "Caption"
        adaptive_height: True

<NavButton@ButtonBehavior+MDBoxLayout>:
    icon: "home-outline"
    text: ""
    active: False
    orientation: "vertical"
    spacing: dp(2)
    padding: dp(4)

    FloatLayout:
        size_hint_y: None
        height: dp(24)

        MDIcon:
            icon: root.icon
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            halign: "center"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: (0.22, 0.92, 0.60, 1) if root.active else (0.50, 0.55, 0.62, 1)
            font_size: "22sp"

    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: (0.22, 0.92, 0.60, 1) if root.active else (0.50, 0.55, 0.62, 1)
        bold: root.active
        adaptive_height: True

# ---------------------------------------------------------------------------
# Layout Raíz (El usuario entra directo)
# ---------------------------------------------------------------------------

<RootLayout@MDBoxLayout>:
    orientation: "vertical"

    ScreenManager:
        id: sm

        HomeScreen:
        MainScreen:
        HistoryScreen:
        RecargarConsultasScreen:
        YapePagoScreen:
        AgroveterinariasScreen:
        AdminScreen:
        TipsScreen:
        MoreScreen:

    # Barra Inferior de Navegación 3D
    MDBoxLayout:
        size_hint_y: None
        height: dp(66)
        padding: dp(6), 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.6
            RoundedRectangle:
                pos: self.x, self.y + dp(3)
                size: self.size
                radius: [22, 22, 0, 0]
            Color:
                rgba: 0.05, 0.07, 0.11, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [22, 22, 0, 0]

        MDBoxLayout:
            NavButton:
                icon: "home-variant"
                text: "Inicio"
                active: app.current_tab == "home"
                on_release: app.go_home()

            NavButton:
                icon: "clipboard-pulse-outline"
                text: "Historial"
                active: app.current_tab == "history"
                on_release: app.go_history()

            FloatLayout:
                size_hint_x: None
                width: dp(64)

                MDFloatingActionButton:
                    icon: "camera"
                    md_bg_color: 0.14, 0.85, 0.55, 1
                    pos_hint: {"center_x": 0.5, "center_y": 0.62}
                    on_release: app.go_diagnosis()

            NavButton:
                icon: "store-marker-outline"
                text: "Agrovets"
                active: app.current_tab == "agrovets"
                on_release: app.go_agrovets()

            NavButton:
                icon: "dots-horizontal"
                text: "Más"
                active: app.current_tab == "more"
                on_release: app.go_more()

# ---------------------------------------------------------------------------
# Pantalla INICIO: Con Medidor de Consultas Gratis
# ---------------------------------------------------------------------------

<HomeScreen>:
    name: "home"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Agrowillay"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["sprout", lambda x: None]]
            right_action_items: [["shield-lock", lambda x: app.prompt_admin_code()]]

        # Barra Superior Sencilla: Consultas Disponibles
        MDBoxLayout:
            size_hint_y: None
            height: dp(36)
            padding: [dp(14), 0]
            canvas.before:
                Color:
                    rgba: 0.08, 0.12, 0.18, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIcon:
                icon: "ticket-percent-outline"
                theme_text_color: "Custom"
                text_color: 0.20, 0.95, 0.60, 1
                size_hint_x: None
                width: dp(24)
                pos_hint: {"center_y": 0.5}

            MDLabel:
                id: lbl_consultas_disponibles
                text: "🎁 Consultas gratis: 10 restantes"
                theme_text_color: "Custom"
                text_color: 0.90, 0.95, 1, 1
                font_style: "Caption"
                bold: True
                pos_hint: {"center_y": 0.5}

            MDTextButton:
                text: "Recargar +"
                font_style: "Caption"
                bold: True
                theme_text_color: "Custom"
                text_color: 0.95, 0.75, 0.20, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.go_recargas()

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(10), dp(16), dp(28)]
                spacing: dp(16)

                # Banner Principal Bienvenida
                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(16), dp(14)
                    spacing: dp(12)
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.5
                        RoundedRectangle:
                            pos: self.x, self.y - dp(4)
                            size: self.size
                            radius: [18,]
                        Color:
                            rgba: 0.10, 0.58, 0.38, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18,]

                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(2)
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "¡Bienvenido, Agricultor!"
                            bold: True
                            font_style: "H6"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            adaptive_height: True

                        MDLabel:
                            text: "Toma una foto a tu planta para detectar plagas y hongos al instante."
                            theme_text_color: "Custom"
                            text_color: 0.90, 0.98, 0.94, 1
                            font_style: "Caption"
                            adaptive_height: True

                    MDIcon:
                        icon: "shield-bug-outline"
                        font_size: "44sp"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 0.95
                        size_hint: None, None
                        size: dp(48), dp(48)
                        pos_hint: {"center_y": 0.5}

                # Tarjeta de Clima 3D
                SectionCard3D:
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDLabel:
                            text: "Clima y Alertas de Heladas"
                            bold: True
                            font_style: "Subtitle1"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            adaptive_height: True

                        MDRaisedButton:
                            text: "Actualizar"
                            md_bg_color: 0.15, 0.22, 0.30, 1
                            on_release: app.check_weather_alerts()

                    MDBoxLayout:
                        id: alerts_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)

                        MDLabel:
                            text: "Consultando el pronóstico para tu cultivo..."
                            theme_text_color: "Custom"
                            text_color: 0.70, 0.75, 0.80, 1
                            font_style: "Caption"
                            adaptive_height: True

                MDLabel:
                    text: "Acciones Rápidas"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    adaptive_height: True

                MDGridLayout:
                    cols: 2
                    spacing: dp(12)
                    adaptive_height: True

                    Button3D:
                        text: "Tomar Foto"
                        icon: "camera"
                        btn_color: 0.10, 0.65, 0.42, 1
                        shadow_color: 0.05, 0.40, 0.24, 1
                        on_release: app.home_take_photo()

                    Button3D:
                        text: "Subir Galería"
                        icon: "image-multiple"
                        btn_color: 0.16, 0.32, 0.50, 1
                        shadow_color: 0.08, 0.18, 0.32, 1
                        on_release: app.home_choose_gallery()

                    Button3D:
                        text: "Mis Diagnósticos"
                        icon: "clipboard-pulse"
                        btn_color: 0.20, 0.55, 0.65, 1
                        shadow_color: 0.10, 0.35, 0.45, 1
                        on_release: app.go_history()

                    Button3D:
                        text: "Agroveterinarias"
                        icon: "store"
                        btn_color: 0.65, 0.35, 0.15, 1
                        shadow_color: 0.40, 0.20, 0.08, 1
                        on_release: app.go_agrovets()

# ---------------------------------------------------------------------------
# Pantalla DIAGNÓSTICO (Con Aviso Automático al Llegar a Cero)
# ---------------------------------------------------------------------------

<MainScreen>:
    name: "main"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Diagnóstico de Planta"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(8), dp(16), dp(30)]
                spacing: dp(14)

                SectionCard3D:
                    # Visor Escáner 3D
                    FloatLayout:
                        size_hint_y: None
                        height: dp(210)

                        canvas.before:
                            Color:
                                rgba: 0.05, 0.07, 0.11, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [16,]
                            Color:
                                rgba: 0.20, 0.95, 0.65, 0.8
                            Line:
                                width: 2
                                points: [self.x + dp(12), self.top - dp(24), self.x + dp(12), self.top - dp(12), self.x + dp(24), self.top - dp(12)]
                            Line:
                                width: 2
                                points: [self.right - dp(24), self.top - dp(12), self.right - dp(12), self.top - dp(12), self.right - dp(12), self.top - dp(24)]
                            Line:
                                width: 2
                                points: [self.x + dp(12), self.y + dp(24), self.x + dp(12), self.y + dp(12), self.x + dp(24), self.y + dp(12)]
                            Line:
                                width: 2
                                points: [self.right - dp(24), self.y + dp(12), self.right - dp(12), self.y + dp(12), self.right - dp(12), self.y + dp(24)]

                        Image:
                            id: preview_image
                            size_hint: 0.92, 0.90
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            allow_stretch: True
                            keep_ratio: True
                            opacity: 1

                        MDLabel:
                            id: preview_placeholder
                            text: "Toma o sube una foto de la hoja o tallo dañado"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.6, 0.65, 0.75, 1
                            font_style: "Caption"
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        Button3D:
                            text: "Tomar Foto"
                            icon: "camera"
                            on_release: app.take_photo()

                        Button3D:
                            text: "Galería"
                            icon: "image"
                            btn_color: 0.16, 0.32, 0.50, 1
                            shadow_color: 0.08, 0.18, 0.32, 1
                            on_release: app.choose_from_gallery()

                    Button3D:
                        id: analyze_btn
                        text: "ANALIZAR PLANTA CON IA"
                        icon: "radar"
                        btn_color: 0.14, 0.85, 0.55, 1
                        disabled: True
                        on_release: app.analyze_photo()

                # Resultado del Diagnóstico
                SectionCard3D:
                    id: result_card
                    opacity: 0
                    disabled: True

                    MDLabel:
                        text: "Resultado del Diagnóstico"
                        bold: True
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        adaptive_height: True

                    MDBoxLayout:
                        id: result_body
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                    Button3D:
                        text: "Ver Agroveterinarias para Comprar Insumos"
                        icon: "store"
                        btn_color: 0.65, 0.35, 0.15, 1
                        on_release: app.go_agrovets()

# ---------------------------------------------------------------------------
# Pantalla RECARGAR CONSULTAS (Opciones claras en Soles)
# ---------------------------------------------------------------------------

<RecargarConsultasScreen>:
    name: "recargas"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Recargar Consultas"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(12), dp(16), dp(30)]
                spacing: dp(14)

                MDBoxLayout:
                    adaptive_height: True
                    padding: dp(14)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 0.08, 0.12, 0.18, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [14,]

                    MDIcon:
                        icon: "information-outline"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        size_hint_x: None
                        width: dp(26)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Elige el paquete que prefieras. Pagas por Yape y tus consultas se activan de inmediato."
                        theme_text_color: "Custom"
                        text_color: 0.85, 0.88, 0.95, 1
                        font_style: "Caption"
                        adaptive_height: True

                # Paquetes por Créditos
                PlanOptionCard:
                    titulo: "Paquete 50 Consultas"
                    precio: "S/ 6.00"
                    descripcion: "Perfecto para revisar tu chacra o huerto en la semana."
                    on_release: app.seleccionar_paquete_yape("50 Consultas", "S/ 6.00", 50)

                PlanOptionCard:
                    titulo: "Paquete 100 Consultas"
                    precio: "S/ 10.00"
                    descripcion: "El más elegido por los agricultores. Consultas para todo el mes."
                    es_destacado: True
                    on_release: app.seleccionar_paquete_yape("100 Consultas", "S/ 10.00", 100)

                PlanOptionCard:
                    titulo: "Paquete 250 Consultas"
                    precio: "S/ 20.00"
                    descripcion: "Para productores con varias parcelas y cultivos extensos."
                    on_release: app.seleccionar_paquete_yape("250 Consultas", "S/ 20.00", 250)

                # Plan Ilimitado
                PlanOptionCard:
                    titulo: "Mes Completo ILIMITADO"
                    precio: "S/ 15.00"
                    descripcion: "Haz todas las consultas que necesites durante 30 días sin límites."
                    es_destacado: True
                    on_release: app.seleccionar_paquete_yape("1 Mes Ilimitado", "S/ 15.00", -1)

                # Opción para canjear código directo
                SectionCard3D:
                    MDLabel:
                        text: "¿Ya tienes un código de recarga?"
                        bold: True
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                    MDTextField:
                        id: input_codigo_recarga
                        hint_text: "Escribe tu código aquí (Ej: AGRO-100)"
                        mode: "fill"

                    Button3D:
                        text: "ACTIVAR CÓDIGO"
                        icon: "ticket-confirmation"
                        btn_color: 0.12, 0.72, 0.48, 1
                        on_release: app.canjear_codigo(input_codigo_recarga.text)

# ---------------------------------------------------------------------------
# Pantalla PAGO CON TU QR DE YAPE
# ---------------------------------------------------------------------------

<YapePagoScreen>:
    name: "yape_pago"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1

        MDTopAppBar:
            title: "Pagar con Yape"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.go_recargas()]]

        ScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(10), dp(16), dp(30)]
                spacing: dp(14)

                SectionCard3D:
                    MDLabel:
                        id: lbl_paquete_elegido
                        text: "Paquete Elegido: 100 Consultas"
                        bold: True
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        adaptive_height: True

                    MDLabel:
                        id: lbl_precio_elegido
                        text: "Monto a Yapear: S/ 10.00"
                        bold: True
                        font_style: "H5"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.95, 0.60, 1
                        adaptive_height: True

                    # Imagen de tu QR de Yape
                    FloatLayout:
                        size_hint_y: None
                        height: dp(260)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [16,]

                        Image:
                            id: img_qr_yape
                            source: "qr_yape.png"
                            size_hint: 0.92, 0.92
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            allow_stretch: True
                            keep_ratio: True

                    MDLabel:
                        text: "1. Abre tu aplicación Yape en el celular.\n2. Escanea este código o toma una captura de pantalla a este QR.\n3. Una vez yapeado, presiona el botón verde de abajo para avisarnos por WhatsApp y activar tus consultas al instante."
                        theme_text_color: "Custom"
                        text_color: 0.85, 0.90, 0.95, 1
                        font_style: "Caption"
                        adaptive_height: True

                    Button3D:
                        text: "ENVIAR COMPROBANTE POR WHATSAPP"
                        icon: "whatsapp"
                        btn_color: 0.10, 0.75, 0.45, 1
                        shadow_color: 0.05, 0.45, 0.25, 1
                        on_release: app.notificar_pago_whatsapp()

                    Button3D:
                        text: "SUBIR CAPTURA DEL YAPE"
                        icon: "image-check"
                        btn_color: 0.16, 0.32, 0.50, 1
                        shadow_color: 0.08, 0.18, 0.32, 1
                        on_release: app.subir_voucher_galeria()

# ---------------------------------------------------------------------------
# Pantallas Historial, Agrovets, Admin, Más
# ---------------------------------------------------------------------------

<HistoryScreen>:
    name: "history"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1
        MDTopAppBar:
            title: "Historial de Cultivos"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
        ScrollView:
            MDBoxLayout:
                id: history_body
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)
                MDLabel:
                    id: history_placeholder
                    text: "Aún no tienes diagnósticos guardados"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.6, 0.65, 0.7, 1

<AgroveterinariasScreen>:
    name: "agrovets"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1
        MDTopAppBar:
            title: "Agroveterinarias"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
        ScrollView:
            MDBoxLayout:
                id: agrovets_list
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)

<AdminScreen>:
    name: "admin"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1
        MDTopAppBar:
            title: "ADMIN---"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            left_action_items: [["arrow-left", lambda x: app.go_more()]]
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)
                SectionCard3D:
                    MDLabel:
                        text: "Generar Código de Recarga para Agricultor"
                        bold: True
                        font_style: "Subtitle1"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                    Button3D:
                        text: "GENERAR CÓDIGO 100 CONSULTAS"
                        on_release: app.admin_generar_codigo(100)
                    Button3D:
                        text: "GENERAR CÓDIGO MES ILIMITADO"
                        btn_color: 0.65, 0.35, 0.15, 1
                        on_release: app.admin_generar_codigo(-1)

<TipsScreen>:
    name: "tips"
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "Consejos"
            left_action_items: [["arrow-left", lambda x: app.go_home()]]

<MoreScreen>:
    name: "more"
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.035, 0.045, 0.07, 1
        MDTopAppBar:
            title: "Más Opciones"
            elevation: 0
            md_bg_color: 0.035, 0.045, 0.07, 1
            left_action_items: [["arrow-left", lambda x: app.go_home()]]
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(12)
                Button3D:
                    text: "ADMIN--- (Acceso con Código)"
                    icon: "shield-lock"
                    btn_color: 0.75, 0.20, 0.30, 1
                    on_release: app.prompt_admin_code()
                Button3D:
                    text: "Recargar Más Consultas con Yape"
                    icon: "qrcode-scan"
                    btn_color: 0.12, 0.65, 0.45, 1
                    on_release: app.go_recargas()