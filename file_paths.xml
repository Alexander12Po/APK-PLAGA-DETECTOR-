<?xml version="1.0" encoding="utf-8"?>
<!--
    Rutas que el FileProvider de Agrowillay puede exponer como content://.
    "path='.'" cubre toda la carpeta, asi no hay que listar cada archivo.

    - files-path      -> corresponde a Context.getFilesDir()
    - external-files-path -> corresponde a Context.getExternalFilesDir(null)

    app_storage_path() de python-for-android puede devolver cualquiera de
    las dos segun el dispositivo, asi que declaramos ambas para curarnos
    en salud.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="agrowillay_files" path="." />
    <external-files-path name="agrowillay_external_files" path="." />
    <cache-path name="agrowillay_cache" path="." />
</paths>
